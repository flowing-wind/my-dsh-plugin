+      if (resolved === undefined) return false
+      const directory = dirname(resolved.currentPath)
+      const child = relative(this.root, directory)
+      if (child === '' || child === '..' || child.startsWith('../') || child.startsWith('..\\') || isAbsolute(child)) {
+        throw new Error('Session directory must be below the persistence root')
+      }
+      lease = await this.acquireLease(id, undefined, directory)
+      await rm(directory, { recursive: true })
+      this.coldLogMemo.delete(id)
+      return true
+    } finally {
+      try { await lease?.release() }
+      finally { this.tracker.releaseClaim(id) }
+    }
+  }
+
