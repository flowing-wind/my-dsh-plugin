{
  "name": "@flowing-wind/dsh-account-balance",
  "version": "1.0.2",
  "description": "DeepSeek API Key account balance and official billing links",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/client.js",
    "cordis.patch.yml",
    "assets/*.webp",
    "assets/*LICENSE.txt"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5"
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "zod": "^4.1.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": "0.2.1-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/flowing-wind/my-dsh-plugin.git",
    "directory": "dist/plugins/account-balance"
  },
  "dshMarket": {
    "title": "API Key 余额",
    "category": "tools",
    "serverBuild": false
  }
}
