{
  "name": "@flowing-wind/dsh-personal-instructions",
  "version": "1.0.4",
  "description": "Home-scoped personal instructions with a settings editor",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": "0.2.1-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/flowing-wind/my-dsh-plugin.git",
    "directory": "dist/plugins/personal-instructions"
  },
  "dshMarket": {
    "title": "全局个性化说明",
    "category": "tools",
    "serverBuild": false
  }
}
